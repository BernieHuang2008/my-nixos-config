// niri 主配置：输入设备、布局、启动项与全局设置。
// 快捷键见 binds.kdl，窗口规则见 window-rules.kdl，显示器见 monitors.kdl。

input {
    keyboard {
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 16
    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
}

spawn-at-startup "fcitx5"
spawn-at-startup "swaybg" "-i" "/home/bernie/.wall-paper.png" "-m" "fill"

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include "binds.kdl"
include "window-rules.kdl"
include "monitors.kdl"
